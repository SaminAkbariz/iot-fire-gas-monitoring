# این فایل یک نمونه است. آن را کپی کن و به نام .env ذخیره کن،
# سپس مقادیر واقعی خودت را جایگزین کن.
#
#   cp .env.example .env

# کلید امنیتی جنگو (یک رشته تصادفی طولانی بگذار)
SECRET_KEY=change-this-to-a-random-secret-key

# حالت دیباگ (در production باید False باشد)
DEBUG=True

# هاست‌های مجاز، با کاما جدا شوند
ALLOWED_HOSTS=*

# تنظیمات ایمیل Gmail برای ارسال هشدارها
# راهنما: باید از App Password جیمیل استفاده کنی، نه رمز اصلی حساب
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
